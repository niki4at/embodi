{
  "expo": {
    "name": "Bodfit",
    "slug": "embodi",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": [
      "embodi",
      "bodfit"
    ],
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.nick4eto.embodi",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.nick4eto.embodi"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png",
      "name": "Bodfit",
      "shortName": "Bodfit",
      "themeColor": "#4B9EFE",
      "backgroundColor": "#FFFFFF",
      "description": "Bodfit: a coach that builds every session around how you feel today."
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 160,
          "resizeMode": "contain",
          "backgroundColor": "#FFFFFF",
          "dark": {
            "backgroundColor": "#0B0B0F"
          }
        }
      ],
      "expo-secure-store",
      "expo-web-browser",
      "expo-font",
      "expo-audio",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Bodfit uses your location while the app is open to suggest whether you are training at Home or Gym. It does not keep a location history."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Bodfit uses your photos so you can identify equipment, save a private home inventory, and find matching exercises.",
          "cameraPermission": "Bodfit uses your camera so you can identify equipment, save a private home inventory, and find matching exercises."
        }
      ],
      [
        "expo-notifications",
        {
          "sounds": [
            "./assets/sounds/rest_done.wav"
          ]
        }
      ],
      "expo-asset"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "b91a84ce-6d3f-46f8-9967-2ad6414cce74"
      }
    },
    "owner": "nick4eto",
    "updates": {
      "url": "https://u.expo.dev/b91a84ce-6d3f-46f8-9967-2ad6414cce74"
    },
    "runtimeVersion": {
      "policy": "appVersion"
    }
  }
}
